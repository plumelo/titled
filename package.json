{
  "name": "@plumelo/titled",
  "version": "2.8.1",
  "description": "A simple collection of CSS mixin and utilities.",
  "author": "Iulian Meghea <iulian@plumelo.com>",
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plumelo/titled.git"
  },
  "homepage": "https://github.com/plumelo/titled#readme",
  "bugs": {
    "url": "https://github.com/plumelo/titled/issues"
  },
  "keywords": [
    "css",
    "lightningcss",
    "css-modules",
    "design-system",
    "utilities"
  ],
  "main": "src/index.css",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/github",
      "@semantic-release/npm",
      "@semantic-release/git"
    ],
    "branches": [
      "main"
    ],
    "preset": "conventionalcommits"
  },
  "exports": {
    ".": "./src/index.css",
    "./input": "./src/input.css",
    "./button": "./src/button.css",
    "./row": "./src/row.css",
    "./media": "./src/media.css",
    "./lightning": "./src/lightning.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "prettier": "^3.2.5",
    "semantic-release": "^25"
  }
}
